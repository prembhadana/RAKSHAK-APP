rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pairingInvites/{code} {
      // Only a signed-in parent may create an invite for their own UID.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['parentUid', 'childUid', 'createdAt', 'expiresAt'])
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.childUid == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(16, 'm');

      // A child can read an unused invite only if they know its 128-bit random code.
      allow get: if request.auth != null && (
        resource.data.parentUid == request.auth.uid
        || (resource.data.childUid == null && resource.data.expiresAt > request.time)
        || resource.data.childUid == request.auth.uid
      );

      // A code can be claimed once. Parent UID and expiry cannot be changed.
      allow update: if request.auth != null
        && resource.data.childUid == null
        && resource.data.expiresAt > request.time
        && request.resource.data.parentUid == resource.data.parentUid
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.childUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childUid', 'claimedAt']);
      allow delete: if false;
    }
  }
}